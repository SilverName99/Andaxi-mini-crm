// Mini-CRM Andaxi — schema Prisma
// SQLite pentru simplitate (un singur utilizator). Trecerea la PostgreSQL
// necesita doar schimbarea provider-ului + DATABASE_URL (nu se folosesc enum-uri,
// tocmai pentru portabilitate intre SQLite si Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Setari globale ale aplicatiei (un singur rand, id = "singleton")
model Settings {
  id String @id @default("singleton")

  // Date firma (folosite in rapoarte / export catre ERP)
  companyName String @default("Andaxi")
  companyCui  String @default("")
  companyIban String @default("")
  companyEmail String @default("")
  /// Calea publica a siglei incarcate (ex. "/uploads/logo-123.png"); gol = fara sigla
  logoUrl      String @default("")

  // Tarife orare (EUR)
  standardRate  Float @default(45)
  offHoursRate  Float @default(90)
  /// Inceputul intervalului cu tarif standard, in minute de la miezul noptii (09:00 = 540)
  standardStart Int   @default(540)
  /// Sfarsitul intervalului cu tarif standard (16:00 = 960)
  standardEnd   Int   @default(960)
  /// Daca e activ, orele din weekend se taxeaza integral cu tariful majorat
  weekendOffHours Boolean @default(false)

  /// Curs EUR -> RON folosit pentru afisarea echivalentului in lei
  eurRon Float @default(5.08)

  /// Cota de TVA (procent) aplicata peste preturi. Toate sumele din aplicatie
  /// sunt fara TVA; cota se foloseste doar la afisarea totalurilor din rapoarte.
  vatRate Float @default(21)

  /// Cu cate zile inainte de scadenta apare alerta "de facturat"
  billingLeadDays Int @default(7)

  // ── Preturi pe utilizator pentru ERP si CRM ────────────────────────────────
  // Trei praguri: pana la Tier1Max utilizatori, pana la Tier2Max, apoi restul.
  // Preturile sunt EUR / utilizator / luna.
  erpTier1Max   Int   @default(5)
  erpTier1Price Float @default(50)
  erpTier2Max   Int   @default(10)
  erpTier2Price Float @default(45)
  erpTier3Price Float @default(40)
  /// Spatiul inclus pe fiecare prag, in GB
  erpTier1StorageGb Float @default(2)
  erpTier2StorageGb Float @default(10)
  erpTier3StorageGb Float @default(15)

  crmTier1Max   Int   @default(5)
  crmTier1Price Float @default(50)
  crmTier2Max   Int   @default(10)
  crmTier2Price Float @default(45)
  crmTier3Price Float @default(40)
  crmTier1StorageGb Float @default(2)
  crmTier2StorageGb Float @default(10)
  crmTier3StorageGb Float @default(15)

  /// Reduceri (procente) pentru plata pe 6 luni, respectiv anual
  discountSemiannual Float @default(5)
  discountAnnual     Float @default(10)

  updatedAt DateTime @updatedAt
}

model Client {
  id        String  @id @default(cuid())
  name      String
  company   String  @default("")
  cui       String  @default("")
  regCom    String  @default("")
  email     String  @default("")
  phone     String  @default("")
  contact   String  @default("")
  website   String  @default("")
  address   String  @default("")
  city      String  @default("")
  county    String  @default("")
  country   String  @default("Romania")
  /// ACTIVE | PROSPECT | INACTIVE
  status    String  @default("ACTIVE")
  /// Culoare accent pentru UI (hex sau nume de tema)
  color     String  @default("violet")
  /// Sigla clientului, salvata in folderul de upload
  logoUrl   String  @default("")
  notes     String  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  workLogs      WorkLog[]
  billingItems  BillingItem[]
  tasks         Task[]
  monthlyDocuments MonthlyDocument[]
  monthlyDiscounts MonthlyDiscount[]

  @@index([status])
}

/// Pachet de ore preplatit: clientul cumpara lunar un numar de ore, la un tarif
/// mai mic decat cel standard. Orele neconsumate se reporteaza in luna urmatoare.
model HourPackage {
  id            String  @id @default(cuid())
  name          String
  /// Cate ore primeste clientul in fiecare luna
  hoursPerMonth Float
  /// Tarifele pachetului, care le inlocuiesc pe cele globale pentru clientii lui
  standardRate  Float
  offHoursRate  Float
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

/// Abonament recurent: gazduire si/sau mentenanta pentru un produs al clientului
model Subscription {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label String
  /// HOSTING | MENTENANTA | HOSTING_MENTENANTA
  kind  String @default("HOSTING_MENTENANTA")
  /// LANDING_PAGE | PREZENTARE | ECOMMERCE | CRM | ERP | ALTUL
  product String @default("PREZENTARE")

  /// Suma pe ciclu, in EUR
  amountEur Float
  /// MONTHLY | SEMIANNUAL | ANNUAL
  cycle     String @default("MONTHLY")

  /// Data primei facturi din serie (YYYY-MM-DD)
  startDate String
  /// Data urmatoarei scadente (YYYY-MM-DD); avanseaza pe masura ce se genereaza pozitii
  nextDueDate String
  /// Optional, data de final a contractului (YYYY-MM-DD)
  endDate   String?

  /// Pentru abonamentele de tip pachet de ore: care pachet a fost cumparat
  hourPackageId String?
  hourPackage   HourPackage? @relation(fields: [hourPackageId], references: [id])

  /// Cate ore de interventie sunt incluse in abonament in fiecare luna.
  /// Orele in afara programului consuma dublu din acest pachet.
  includedHoursPerMonth Float @default(0)

  /// Numar de utilizatori — doar pentru ERP/CRM, cand pretul se calculeaza automat.
  /// Daca lipseste, suma a fost stabilita manual.
  users Int?

  /// Cat spatiu ocupa efectiv clientul, completat manual (GB)
  storageUsedGb     Float?
  storageUpdatedAt  String?

  userChanges SubscriptionUserChange[]

  /// ACTIVE | PAUSED | CANCELLED
  status String @default("ACTIVE")
  notes  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingItems BillingItem[]

  @@index([clientId])
  @@index([status])
}

/// O pozitie de facturat generata dintr-un abonament (o perioada = o pozitie)
model BillingItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Perioada acoperita (YYYY-MM-DD)
  periodStart String
  periodEnd   String
  /// Data la care trebuie emisa factura (YYYY-MM-DD)
  dueDate     String

  amountEur Float
  /// PENDING | INVOICED | PAID | SKIPPED
  status    String  @default("PENDING")
  /// Numarul facturii emise in ERP (referinta externa)
  invoiceRef String @default("")
  invoicedAt String?
  paidAt     String?
  notes      String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([status])
  @@index([dueDate])
}

/// Ore de interventie / suport tehnic
model WorkLog {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// YYYY-MM-DD
  date         String
  /// Cum a fost introdusa munca: INTERVAL (de la ora X la ora Y) sau
  /// DURATION (doar numarul de ore, cum se noteaza la lucrarile de dezvoltare)
  entryMode String @default("INTERVAL")

  /// Minute de la miezul noptii; la intrarile de tip DURATION raman 0
  startMinutes Int
  endMinutes   Int

  description String @default("")
  /// SUPORT | INTERVENTIE | DEZVOLTARE | CONSULTANTA | ALTUL
  category    String @default("SUPORT")
  /// Eticheta libera pentru gruparea orelor pe lucrari ("Dezvoltare CRM", "Implementare ERP")
  projectTag  String @default("")

  /// Minutele facturate la tarif standard, respectiv majorat (calculate la salvare)
  standardMinutes Int
  offHoursMinutes Int
  /// Tarifele aplicate (istoric, ca modificarea setarilor sa nu rescrie trecutul)
  standardRate Float
  offHoursRate Float
  /// Total EUR pentru inregistrare (poate fi suprascris manual)
  amountEur    Float
  /// Daca e true, amountEur a fost setat manual si nu se recalculeaza
  manualAmount Boolean @default(false)

  attachments Attachment[]

  billable Boolean @default(true)
  /// Orele acoperite explicit de abonament / pachetul de ore: nu se factureaza,
  /// dar consuma din creditul lunii (spre deosebire de munca facuta din curtoazie)
  includedInPackage Boolean @default(false)
  /// PENDING | INVOICED | PAID | NONBILLABLE
  status   String  @default("PENDING")
  invoiceRef String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([date])
  @@index([status])
}

/// Task-uri / remindere simple, pentru "ordine in firma"
model Task {
  id       String  @id @default(cuid())
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  title    String
  details  String  @default("")
  /// YYYY-MM-DD
  dueDate  String?
  /// LOW | MEDIUM | HIGH
  priority String  @default("MEDIUM")
  done     Boolean @default(false)
  doneAt   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([done])
  @@index([dueDate])
}

/// Fisier atasat unei interventii (deviz, proces-verbal, raport etc.)
model Attachment {
  id        String  @id @default(cuid())
  workLogId String
  workLog   WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  /// Numele original, asa cum l-a incarcat utilizatorul
  fileName String
  mimeType String
  /// Marimea in bytes
  size     Int
  /// Calea pe disc, relativa la folderul de upload
  path     String

  createdAt DateTime @default(now())

  @@index([workLogId])
}

/// Istoricul modificarilor de utilizatori la un abonament ERP/CRM.
/// Tine minte de cand se aplica pretul nou si cat ar trebui prorat pentru
/// perioada in curs, ca sa nu se piarda diferenta.
model SubscriptionUserChange {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Data de la care se aplica noul numar de utilizatori (YYYY-MM-DD)
  effectiveDate String
  previousUsers Int
  newUsers      Int
  previousAmountEur Float
  newAmountEur      Float

  /// Diferenta calculata pentru restul perioadei in curs
  proratedEur Float @default(0)
  /// Pozitia din scadentar peste care s-ar aplica diferenta
  billingItemId String?
  /// Daca diferenta a fost deja adaugata la acea pozitie
  applied     Boolean @default(false)

  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([subscriptionId])
}

/// Document atasat unei luni de lucru la un client: raportul cu toate
/// modificarile, trimis odata cu factura.
model MonthlyDocument {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Luna la care se refera, "YYYY-MM"
  month    String
  fileName String
  mimeType String
  size     Int
  path     String
  note     String @default("")

  createdAt DateTime @default(now())

  @@index([clientId, month])
}

/// Reducere aplicata orelor unei luni la un client: fie procent, fie suma fixa.
model MonthlyDiscount {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Luna la care se aplica, "YYYY-MM"
  month String
  /// PERCENT | AMOUNT
  type  String @default("PERCENT")
  /// Procentul sau suma in EUR, dupa tip
  value Float
  note  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, month])
}
