# Baza de date. Calea SQLite e relativa la folderul prisma/ (deci fisierul ajunge in server/prisma/dev.db).
# In productie foloseste o cale absoluta, ex: file:/var/www/andaxi-crm/data/crm.db
# Pentru PostgreSQL: postgresql://user:parola@host:5432/andaxi_crm
DATABASE_URL="file:./dev.db"

# Secret pentru semnarea token-urilor de sesiune — OBLIGATORIU in productie.
# Genereaza-l cu: openssl rand -hex 32
JWT_SECRET="dev-secret-schimba-ma"

# Portul pe care asculta API-ul
PORT=4000

# Originile permise pentru frontend (separate prin virgula)
CORS_ORIGINS="http://localhost:5173"

# Durata sesiunii, in zile
SESSION_DAYS=30

# Contul initial creat de `npm run db:seed`
SEED_EMAIL="alexandru.serac99@gmail.com"
SEED_PASSWORD="schimba-parola"
SEED_NAME="Alexandru"

# Daca e "true", seed-ul adauga si date demonstrative (clienti/abonamente/ore)
SEED_DEMO="false"
